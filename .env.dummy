# API Gateway base URL for the purchase-sales backend
API_BASE_URL=https://<api-id>.execute-api.<region>.amazonaws.com/stg

# AccessKey for local development (route A). Leave empty/unset to force the Cognito login flow.
# Do not put a real AccessKey in a build meant for stg (see docs/spec/purchase-sales-frontend/design.md).
ACCESS_KEY=

# Cognito Hosted UI settings (route B). Provided by fasse_infra once Phase 2 (Cognito) is set up.
COGNITO_DOMAIN=https://<prefix>.auth.<region>.amazoncognito.com
COGNITO_CLIENT_ID=<cognito-app-client-id>
